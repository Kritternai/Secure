FROM osixia/openldap:1.5.0

ENV LDAP_ORGANISATION="Mutillidae"
ENV LDAP_DOMAIN="mutillidae.localhost"
ENV LDAP_ADMIN_PASSWORD=mutillidae
ENV LDAP_CONFIG_ADMIN_PASSWORD=mutillidae
ENV LDAP_READONLY_USER=false
ENV LDAP_RFC2307BIS_SCHEMA=false
ENV LDAP_BACKEND=mdb
ENV LDAP_TLS=false
ENV LDAP_REPLICATION=false

EXPOSE 389 636

