FROM php:8.1-apache

RUN apt-get update && apt-get install -y \
    libldap2-dev \
    libzip-dev \
    unzip \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-install mysqli pdo pdo_mysql ldap zip

RUN a2enmod rewrite ssl

COPY src/ /var/www/html/

RUN chown -R www-data:www-data /var/www/html && \
    chmod -R 755 /var/www/html

RUN printf '#!/bin/bash\n\
set -e\n\
# Update config files if they still have 127.0.0.1\n\
if grep -q "127.0.0.1" /var/www/html/includes/database-config.inc 2>/dev/null; then\n\
    sed -i "s/127.0.0.1/database/g" /var/www/html/includes/database-config.inc\n\
fi\n\
if grep -q "127.0.0.1" /var/www/html/includes/ldap-config.inc 2>/dev/null; then\n\
    sed -i "s/127.0.0.1/directory/g" /var/www/html/includes/ldap-config.inc\n\
fi\n\
exec apache2-foreground\n' > /usr/local/bin/docker-entrypoint.sh && \
    chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 80 443

CMD ["/usr/local/bin/docker-entrypoint.sh"]

